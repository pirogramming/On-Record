# Copy this file to .env and replace values for your local environment.
# Do not commit the real .env file.

# Django
SECRET_KEY=django-insecure-change-me-for-local-development-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings

# Database
# PostgreSQL example:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=onrecord
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# For SQLite local testing, you can use:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Email (Naver SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_SECRET=
NAVER_REDIRECT_URI=http://127.0.0.1:8000/users/naver/callback/

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/users/kakao/callback/

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# OpenAI
OPENAI_API_KEY=
